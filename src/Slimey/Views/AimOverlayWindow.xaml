<Window x:Class="Slimey.Views.AimOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlimeyAim"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Focusable="False" IsHitTestVisible="False"
        ResizeMode="NoResize" SizeToContent="Manual">
    <Canvas x:Name="AimCanvas" IsHitTestVisible="False">
        <!-- 조준 가이드(공이 나갈 방향) -->
        <Line x:Name="GuideLine" Stroke="#88FFFFFF" StrokeThickness="2" StrokeDashArray="4 4"/>
        <!-- 큐대(고정 길이·뒤로 당겨짐, 실제 큐 색: 밑동 검정→갈색→손잡이→단풍나무→흰 페룰) -->
        <Polygon x:Name="Cue">
            <Polygon.Fill>
                <LinearGradientBrush x:Name="CueBrush" MappingMode="Absolute">
                    <GradientStop Color="#111111" Offset="0.0"/>
                    <GradientStop Color="#111111" Offset="0.035"/>
                    <GradientStop Color="#4A2E1C" Offset="0.07"/>
                    <GradientStop Color="#7A4A28" Offset="0.13"/>
                    <GradientStop Color="#20140C" Offset="0.22"/>
                    <GradientStop Color="#C9A24A" Offset="0.29"/>
                    <GradientStop Color="#E6C79A" Offset="0.34"/>
                    <GradientStop Color="#D9B382" Offset="0.9"/>
                    <GradientStop Color="#F4EEDF" Offset="0.955"/>
                    <GradientStop Color="#9FD0E8" Offset="1.0"/>
                </LinearGradientBrush>
            </Polygon.Fill>
        </Polygon>
    </Canvas>
</Window>
