<UserControl x:Class="Slimey.Views.Skins.BasketballSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <Viewbox Stretch="Uniform">
        <Grid Width="96" Height="96">
            <!-- 그림자 -->
            <Ellipse Margin="16,22,16,6" Fill="#33000000">
                <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
            </Ellipse>

            <!-- 공 본체(주황, 코드에서 그라데이션 지정) -->
            <Ellipse x:Name="Body" Margin="6"/>

            <!-- 씸(seam) 무늬: 코드가 패턴을 그린다. 공 원으로 클립되며 튈 때마다 교체. -->
            <Grid x:Name="SeamHost" Margin="6">
                <Path x:Name="Seams" Stroke="#141410" StrokeThickness="3.1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SeamMirror" ScaleX="1"/>
                            <RotateTransform x:Name="SeamRotate" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- 가장자리 음영(구면 볼륨) -->
            <Ellipse Margin="6" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.66"/>
                        <GradientStop Color="#33000000" Offset="0.9"/>
                        <GradientStop Color="#66000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 광택 하이라이트 -->
            <Ellipse Width="24" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="22,16,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B0FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 두꺼운 검정 테두리(농구공 특유) -->
            <Ellipse x:Name="Outline" Margin="6" Stroke="#141410" StrokeThickness="3.4" IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</UserControl>
