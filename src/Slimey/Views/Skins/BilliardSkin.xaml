<UserControl x:Class="Slimey.Views.Skins.BilliardSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <Viewbox Stretch="Uniform">
        <Grid Width="96" Height="96">
            <!-- 그림자 -->
            <Ellipse Margin="16,22,16,6" Fill="#33000000">
                <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
            </Ellipse>

            <!-- 공 본체(색은 코드에서 지정) -->
            <Ellipse x:Name="Body" Margin="6"/>

            <!-- 8번공 번호판(기본 숨김) -->
            <Ellipse x:Name="NumBadge" Width="38" Height="38" Fill="#FAFAFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="NumText" Text="8" FontFamily="Segoe UI" FontWeight="Bold" FontSize="24"
                       Foreground="#1C1C22" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,-1,0,0" Visibility="Collapsed"/>

            <!-- 가장자리 음영(구면 볼륨) -->
            <Ellipse Margin="6" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.68"/>
                        <GradientStop Color="#3A000000" Offset="0.9"/>
                        <GradientStop Color="#70000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 광택 하이라이트 -->
            <Ellipse Width="26" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="22,16,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#E6FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 테두리 -->
            <Ellipse Margin="6" Stroke="#40000000" StrokeThickness="1" IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</UserControl>
