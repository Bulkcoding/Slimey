<UserControl x:Class="Slimey.Views.Skins.BowlingSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True">
    <Viewbox Stretch="Uniform">
        <Grid Width="96" Height="96">
            <!-- 그림자 -->
            <Ellipse Margin="16,22,16,6" Fill="#33000000">
                <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
            </Ellipse>

            <!-- 공 표면(베이스 + 마블 무늬 + 손가락 구멍): 원형으로 클립.
                 PatternHost 안의 무늬 레이어를 코드가 채우고, 굴러가며 교체한다. -->
            <Grid x:Name="Surface" Margin="6">
                <Grid.Clip>
                    <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42"/>
                </Grid.Clip>
                <!-- 베이스 구체 색(코드에서 지정) -->
                <Ellipse x:Name="Body"/>
                <!-- 마블 무늬 + 구멍(코드가 9종 생성, 하나만 표시) -->
                <Grid x:Name="PatternHost"/>
            </Grid>

            <!-- 가장자리 음영(구면 볼륨) -->
            <Ellipse Margin="6" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.6"/>
                        <GradientStop Color="#40000000" Offset="0.87"/>
                        <GradientStop Color="#82000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 광택 하이라이트(좌상단) -->
            <Ellipse Width="30" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="24,13,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 테두리 -->
            <Ellipse Margin="6" Stroke="#55000000" StrokeThickness="1" IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</UserControl>
