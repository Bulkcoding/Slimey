<Window x:Class="Slimey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slimey 설정"
        Width="720" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True" FontFamily="Segoe UI">

    <Border CornerRadius="14" Background="{StaticResource WinBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Grid Grid.Row="0" Background="{StaticResource SideBg}" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="16" Height="16">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A8F0DD" Offset="0"/>
                                <GradientStop Color="#8B6FD6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Slimey 설정" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="OnClose" Width="42" Height="42" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                        FontSize="13" Cursor="Hand"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <Border Grid.Column="0" Background="{StaticResource SideBg}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="12,12,12,6" CornerRadius="9" Background="{StaticResource CardBg}" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#4ED17A" VerticalAlignment="Center"/>
                                <TextBlock Text="Slimey" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="Nav" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnNavChanged" ItemContainerStyle="{StaticResource NavItem}">
                            <ListBoxItem Content="일반" IsSelected="True"/>
                            <ListBoxItem Content="테마"/>
                            <ListBoxItem Content="소리"/>
                            <ListBoxItem Content="단축키"/>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 내용 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
                    <Grid>
                        <!-- ══ 일반 ══ -->
                        <StackPanel x:Name="PanelGeneral">
                            <TextBlock Text="일반" Style="{StaticResource H1}"/>
                            <TextBlock Text="슬라임의 물리와 동작을 조절합니다." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>

                            <TextBlock Text="모양 / 물리" Style="{StaticResource Section}"/>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="크기" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="슬라임 크기를 조절합니다." Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="48" Maximum="180" Value="{Binding SlimeSize}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SlimeSize, StringFormat={}{0:0}px}"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Bounce Power" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="벽에 튕기는 반발력." Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="0.95" Value="{Binding Restitution}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Restitution, StringFormat={}{0:P0}}"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Slime Softness" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="말랑말랑한 정도." Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding Softness}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Softness, StringFormat={}{0:P0}}"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="던지기 가중치" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="마우스 속도에 곱하는 가중치 (1.0 = 실제 속도)." Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0.3" Maximum="2.0" Value="{Binding ThrowPower}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding ThrowPower, StringFormat={}{0:0.0}x}"/>
                                </Grid>
                            </Grid>

                            <TextBlock Text="동작" Style="{StaticResource Section}"/>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Throw Mode (던지기)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ThrowMode}"/>
                            </Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Punch Mode (때리기/열기)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding PunchMode}"/>
                            </Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="항상 위(Always on Top)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AlwaysOnTop}"/>
                            </Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="일시 정지" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Paused}"/>
                            </Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="슬라임 표시" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding SlimeVisible}"/>
                            </Grid>

                            <!-- 당구(당구공 스킨일 때만 표시) -->
                            <StackPanel x:Name="BilliardSection">
                                <TextBlock Text="당구 (당구공 스킨 전용)" Style="{StaticResource Section}"/>
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="큐대로 때리기" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="켜면 공을 직접 던지지 않고, 공 근처를 눌러 큐대를 당겨 밀어서 발사합니다." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding CueStickMode}"/>
                                </Grid>
                            </StackPanel>

                            <Button Style="{StaticResource GhostButton}" Content="위치 초기화" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Click="OnResetPosition"/>
                        </StackPanel>

                        <!-- ══ 테마 ══ -->
                        <StackPanel x:Name="PanelTheme" Visibility="Collapsed">
                            <TextBlock Text="테마" Style="{StaticResource H1}"/>
                            <TextBlock Text="슬라임 스킨을 고르세요. 카드를 눌러 미리보고 바로 적용됩니다." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="ThemeCards" Margin="0,16,0,0"/>
                        </StackPanel>

                        <!-- ══ 소리 ══ -->
                        <StackPanel x:Name="PanelSound" Visibility="Collapsed">
                            <TextBlock Text="소리 / 효과" Style="{StaticResource H1}"/>
                            <TextBlock Text="효과음과 충돌 파티클을 설정합니다." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>

                            <TextBlock Text="소리" Style="{StaticResource Section}"/>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sound Effects" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding SoundEnabled}"/>
                            </Grid>
                            <Grid Margin="0,10,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Volume" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" Value="{Binding SoundVolume}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding SoundVolume, StringFormat={}{0:P0}}"/>
                                </Grid>
                            </Grid>

                            <TextBlock Text="효과" Style="{StaticResource Section}"/>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Particles (충돌 파티클)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding ParticlesEnabled}"/>
                            </Grid>
                        </StackPanel>

                        <!-- ══ 단축키 ══ -->
                        <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
                            <TextBlock Text="단축키" Style="{StaticResource H1}"/>
                            <TextBlock Text="전역 단축키로 슬라임을 다룹니다." Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>

                            <TextBlock Text="잡기" Style="{StaticResource Section}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="슬라임 잡기(커서로 회수)" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="날아가는 슬라임을 마우스 커서 위치로 즉시 데려와 잡습니다." Style="{StaticResource RowDesc}"/>
                                    <TextBlock Text="'변경' 후 원하는 키/마우스 조합을 누르고, '저장'을 눌러야 적용됩니다. (Ctrl·Shift·Alt + 키/클릭, 복합키 가능)"
                                               Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="RebindBtn" Style="{StaticResource GhostButton}"
                                        MinWidth="160" VerticalAlignment="Center" Click="OnRebindCatch"/>
                            </Grid>

                            <!-- 저장: 우측 하단에 여유있게 -->
                            <Button x:Name="SaveBtn" Style="{StaticResource AccentButton}" Content="저장"
                                    MinWidth="120" Height="38" HorizontalAlignment="Right"
                                    Margin="0,28,0,0" Click="OnSaveHotkey" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
