<Window x:Class="ThrowMe.Views.ScoreboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMeScore"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Focusable="False" IsHitTestVisible="False"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="200" Height="120" Left="0" Top="0">
    <!-- 패널은 코드에서 px 크기로 구성, Viewbox 가 창(DIP)에 맞춰 스케일 → DPI 무관. -->
    <Viewbox x:Name="Box" Stretch="Fill" IsHitTestVisible="False"/>
</Window>
