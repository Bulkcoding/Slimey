<Window x:Class="ThrowMe.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMeToast"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False" Focusable="False"
        FontFamily="Pretendard, Malgun Gothic">

    <Border x:Name="Card" CornerRadius="10" Background="#2B2B31"
            BorderBrush="#3A3A42" BorderThickness="1" Padding="14,11"
            MinWidth="240" MaxWidth="340" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 공 아이콘 -->
            <Ellipse Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#A8F0DD" Offset="0"/>
                        <GradientStop Color="#8B6FD6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Text="ThrowMe" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#EAEAEE" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" FontSize="12" Foreground="#8C8C96"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
