<Window x:Class="ThrowMe.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrowMe 업데이트"
        Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontFamily="Pretendard, Malgun Gothic" Icon="/Resources/ThrowMe.ico">

    <Border CornerRadius="16" Background="{StaticResource WinBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 바 -->
            <Grid Grid.Row="0" Background="{StaticResource SideBg}" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="16" Height="16">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A8F0DD" Offset="0"/>
                                <GradientStop Color="#8B6FD6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="ThrowMe 업데이트" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="OnLater" Width="42" Height="42" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                        FontSize="13" Cursor="Hand"/>
            </Grid>

            <!-- 본문 -->
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <Border HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource Accent}" Padding="9,3">
                    <TextBlock x:Name="VersionBadge" Text="v1.0.0" Foreground="White"
                               FontSize="11.5" FontWeight="Bold"/>
                </Border>
                <TextBlock Style="{StaticResource H1}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="새 버전을 받았습니다"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="지금 재시작하면 바로 적용됩니다. 잠깐 꺼졌다가 자동으로 다시 켜집니다."/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="나중에 하면 다음에 앱을 켤 때 조용히 적용됩니다."/>
            </StackPanel>

            <!-- 무엇이 바뀌는지: 받아 둔 릴리스 노트를 여기서 미리 보여준다.
                 예전에는 재시작한 뒤에야 내용을 알 수 있어, 뭘 받는지 모르고 결정해야 했다. -->
            <ScrollViewer x:Name="NotesScroll" Grid.Row="2" Margin="24,14,16,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel x:Name="NotesPanel" Margin="0,0,8,0"/>
            </ScrollViewer>

            <!-- 하단 -->
            <Grid Grid.Row="3" Margin="24,20,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="MuteToggle" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    <TextBlock Text="다음부터 묻지 않기" Style="{StaticResource RowDesc}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="나중에" Click="OnLater"
                            MinWidth="90" Height="38"/>
                    <Button Style="{StaticResource AccentButton}" Content="지금 재시작" Click="OnRestartNow"
                            MinWidth="110" Height="38" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
